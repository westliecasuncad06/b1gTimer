# B1G Timer MVP - Environment Configuration Template
# Copy this file to .env and fill in your local values
# .env is gitignored and should never be committed

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=b1g_timer_dev

# API Configuration
API_BASE_URL=http://localhost:8000
API_PORT=8000

# Timezone Configuration
# SERVER_TIMEZONE: Timezone for database timestamps and backend calculations (typically UTC or server timezone)
# VENUE_TIMEZONE: Timezone for "current time at venue" display (local timezone where event is hosted)
# Examples: Asia/Manila, America/Chicago, America/New_York, UTC, Europe/London, Asia/Tokyo
SERVER_TIMEZONE=UTC
VENUE_TIMEZONE=Asia/Manila

# Pusher Real-Time Communication (for internet-based Control Dashboard & Stage Display sync)
# Sign up for free at https://pusher.com (100 concurrent connections per app instance)
# This allows mobile phones to control the Stage Display over the internet (not same-origin only)
PUSHER_KEY=your_pusher_key_here
PUSHER_SECRET=your_pusher_secret_here
PUSHER_CLUSTER=mt1
PUSHER_ENCRYPTED=true

# PHP Configuration
PHP_ENVIRONMENT=development
# Possible values: development, staging, production
# In development: detailed errors displayed, no production optimizations
# In production: errors logged only, security hardening enabled
