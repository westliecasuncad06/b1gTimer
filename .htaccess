# B1G Timer - URL Rewriting Configuration
#
# XAMPP local:   RewriteBase /B1G_TIMER/
# InfinityFree:  RewriteBase /
# Change the RewriteBase line below when you deploy.

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # ── CHANGE THIS for your environment ──
    # For XAMPP local testing:  RewriteBase /B1G_TIMER/
    # For InfinityFree hosting: RewriteBase /
    RewriteBase /B1G_TIMER/

    # Redirect bare root to public/index.html (main dashboard)
    RewriteRule ^$ public/index.html [L,R=302]

    # Existing files/dirs served directly (CSS, JS, images, HTML)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Route /api/* to api/index.php (clean REST URLs)
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# ── Cache-Control headers ──
<IfModule mod_headers.c>
    # HTML files: never cache (browser always gets latest with updated ?v= params)
    <FilesMatch "\\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # JS/CSS files: cache 1 hour (version query string forces fresh download)
    <FilesMatch "\\.(js|css)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    # PHP API responses: never cache
    <FilesMatch "\\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
