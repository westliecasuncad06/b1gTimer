
# Only allow image files
<FilesMatch "\.(?i:jpe?g|png|webp)$">
    Allow from all
</FilesMatch>

<FilesMatch "\.(?!(?i:jpe?g|png|webp)$)">
    Deny from all
</FilesMatch>

# Disable script execution
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .phps
AddHandler default-handler .php .phtml .php3 .php4 .php5 .phps

# Disable directory listing
Options -Indexes
